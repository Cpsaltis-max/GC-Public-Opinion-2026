u03ad\u03c1\u03b5\u03c5\u03bd\u03b1 \u0397 \u03ad\u03c1\u03b5\u03c5\u03bd\u03b1 \u03b1\u03c5\u03c4\u03ae \u03b6\u03b7\u03c4\u03ac \u03c4\u03b9\u03c2 \u03b1\u03c0\u03cc\u03c8\u03b5\u03b9\u03c2 \u03c3\u03b1\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b9\u03c2 \u03b5\u03c0\u03b5\u03c1\u03c7\u03cc\u03bc\u03b5\u03bd\u03b5\u03c2 \u03b2\u03bf\u03c5\u03bb\u03b5\u03c5\u03c4\u03b9\u03ba\u03ad\u03c2 \u03b5\u03ba\u03bb\u03bf\u03b3\u03ad\u03c2...","QuestionID":"QID4","QuestionText":"\u03a3\u03c7\u03b5\u03c4\u03b9\u03ba\u03ac \u03bc\u03b5 \u03c4\u03b7\u03bd \u03ad\u03c1\u03b5\u03c5\u03bd\u03b1<br>\u0397 \u03ad\u03c1\u03b5\u03c5\u03bd\u03b1 \u03b1\u03c5\u03c4\u03ae \u03b6\u03b7\u03c4\u03ac \u03c4\u03b9\u03c2 \u03b1\u03c0\u03cc\u03c8\u03b5\u03b9\u03c2 \u03c3\u03b1\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b9\u03c2 \u03b5\u03c0\u03b5\u03c1\u03c7\u03cc\u03bc\u03b5\u03bd\u03b5\u03c2 \u03b2\u03bf\u03c5\u03bb\u03b5\u03c5\u03c4\u03b9\u03ba\u03ad\u03c2 \u03b5\u03ba\u03bb\u03bf\u03b3\u03ad\u03c2 \u03c4\u03bf 2026, \u03c4\u03b9\u03c2 \u03c0\u03c1\u03bf\u03b5\u03b4\u03c1\u03b9\u03ba\u03ad\u03c2 \u03b5\u03ba\u03bb\u03bf\u03b3\u03ad\u03c2 \u03c4\u03bf\u03c5 2028&nbsp; \u03ba\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03c4\u03b7 \u0394\u03b9\u03b6\u03c9\u03bd\u03b9\u03ba\u03ae \u0394\u03b9\u03ba\u03bf\u03b9\u03bd\u03bf\u03c4\u03b9\u03ba\u03ae \u039f\u03bc\u03bf\u03c3\u03c0\u03bf\u03bd\u03b4\u03af\u03b1 (\u0394\u0394\u039f) \u03c9\u03c2 \u03c0\u03b9\u03b8\u03b1\u03bd\u03cc \u03c0\u03bb\u03b1\u03af\u03c3\u03b9\u03bf \u03b3\u03b9\u03b1 \u03bc\u03b9\u03b1 \u03bc\u03b5\u03bb\u03bb\u03bf\u03bd\u03c4\u03b9\u03ba\u03ae \u03b4\u03b9\u03b5\u03c5\u03b8\u03ad\u03c4\u03b7\u03c3\u03b7 \u03c3\u03c4\u03bf \u039a\u03c5\u03c0\u03c1\u03b9\u03b1\u03ba\u03cc. <br><br>\u0398\u03b1 \u03b4\u03b5\u03af\u03c4\u03b5 \u03c3\u03cd\u03bd\u03c4\u03bf\u03bc\u03b5\u03c2 \u03b4\u03b7\u03bb\u03ce\u03c3\u03b5\u03b9\u03c2 \u03c5\u03c0\u03ad\u03c1 \u03ba\u03b1\u03b9 \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03c2 \u0394\u0394\u039f \u03ba\u03b1\u03b9 \u03b8\u03b1 \u03b5\u03c0\u03b9\u03bb\u03ad\u03be\u03b5\u03c4\u03b5 \u03c0\u03bf\u03b9\u03b5\u03c2 \u03b2\u03c1\u03af\u03c3\u03ba\u03b5\u03c4\u03b5 \u03c0\u03b9\u03bf \u03c0\u03b5\u03b9\u03c3\u03c4\u03b9\u03ba\u03ad\u03c2. \u0394\u03b5\u03bd \u03c5\u03c0\u03ac\u03c1\u03c7\u03bf\u03c5\u03bd \u03c3\u03c9\u03c3\u03c4\u03ad\u03c2 \u03ae \u03bb\u03ac\u03b8\u03bf\u03c2 \u03b1\u03c0\u03b1\u03bd\u03c4\u03ae\u03c3\u03b5\u03b9\u03c2\u2014\u03b6\u03b7\u03c4\u03bf\u03cd\u03bc\u03b5 \u03c4\u03b7\u03bd \u03b5\u03b9\u03bb\u03b9\u03ba\u03c1\u03b9\u03bd\u03ae \u03c3\u03b1\u03c2 \u03ac\u03c0\u03bf\u03c8\u03b7.\n<br><br>\u0397 \u0394\u0394\u039f \u03b5\u03af\u03bd\u03b1\u03b9 \u03ad\u03bd\u03b1 \u03bf\u03bc\u03bf\u03c3\u03c0\u03bf\u03bd\u03b4\u03b9\u03b1\u03ba\u03cc \u03c3\u03cd\u03c3\u03c4\u03b7\u03bc\u03b1 \u03bc\u03b5 \u03b4\u03cd\u03bf \u03c3\u03c5\u03bd\u03b9\u03c3\u03c4\u03ce\u03bd\u03c4\u03b5\u03c2 \u03c0\u03bf\u03bb\u03b9\u03c4\u03b5\u03af\u03b5\u03c2 (\u03b3\u03b5\u03c9\u03b3\u03c1\u03b1\u03c6\u03b9\u03ba\u03ad\u03c2 \u03c0\u03b5\u03c1\u03b9\u03bf\u03c7\u03ad\u03c2) \u03ba\u03b1\u03b9 \u03ba\u03bf\u03b9\u03bd\u03ac \u03ba\u03b5\u03bd\u03c4\u03c1\u03b9\u03ba\u03ac \u03b8\u03b5\u03c3\u03bc\u03b9\u03ba\u03ac \u03cc\u03c1\u03b3\u03b1\u03bd\u03b1. \u039f \u03b1\u03ba\u03c1\u03b9\u03b2\u03ae\u03c2 \u03c3\u03c7\u03b5\u03b4\u03b9\u03b1\u03c3\u03bc\u03cc\u03c2 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b4\u03b9\u03b1\u03c6\u03ad\u03c1\u03b5\u03b9. \u0397 \u03ad\u03c1\u03b5\u03c5\u03bd\u03b1 \u03b4\u03b5\u03bd \u03c0\u03c1\u03bf\u03cb\u03c0\u03bf\u03b8\u03ad\u03c4\u03b5\u03b9 \u03c3\u03c5\u03b3\u03ba\u03b5\u03ba\u03c1\u03b9\u03bc\u03ad\u03bd\u03bf \u03c3\u03c7\u03ad\u03b4\u03b9\u03bf \u03b5\u03be\u03b5\u03c4\u03ac\u03b6\u03b5\u03b9 \u03b3\u03b5\u03bd\u03b9\u03ba\u03ad\u03c2 \u03c3\u03c4\u03ac\u03c3\u03b5\u03b9\u03c2 \u03ba\u03b1\u03b9 \u03c0\u03ce\u03c2 \u03b3\u03af\u03bd\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b4\u03b5\u03ba\u03c4\u03ac \u03b4\u03b9\u03b1\u03c6\u03bf\u03c1\u03b5\u03c4\u03b9\u03ba\u03ac \u03b5\u03c0\u03b9\u03c7\u03b5\u03b9\u03c1\u03ae\u03bc\u03b1\u03c4\u03b1.","QuestionText_Unsafe":"\u03a3\u03c7\u03b5\u03c4\u03b9\u03ba\u03ac \u03bc\u03b5 \u03c4\u03b7\u03bd \u03ad\u03c1\u03b5\u03c5\u03bd\u03b1<br>\u0397 \u03ad\u03c1\u03b5\u03c5\u03bd\u03b1 \u03b1\u03c5\u03c4\u03ae \u03b6\u03b7\u03c4\u03ac \u03c4\u03b9\u03c2 \u03b1\u03c0\u03cc\u03c8\u03b5\u03b9\u03c2 \u03c3\u03b1\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b9\u03c2 \u03b5\u03c0\u03b5\u03c1\u03c7\u03cc\u03bc\u03b5\u03bd\u03b5\u03c2 \u03b2\u03bf\u03c5\u03bb\u03b5\u03c5\u03c4\u03b9\u03ba\u03ad\u03c2 \u03b5\u03ba\u03bb\u03bf\u03b3\u03ad\u03c2 \u03c4\u03bf 2026 \u03ba\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03c4\u03b7 \u0394\u03b9\u03b6\u03c9\u03bd\u03b9\u03ba\u03ae \u0394\u03b9\u03ba\u03bf\u03b9\u03bd\u03bf\u03c4\u03b9\u03ba\u03ae \u039f\u03bc\u03bf\u03c3\u03c0\u03bf\u03bd\u03b4\u03af\u03b1 (\u0394\u0394\u039f) \u03c9\u03c2 \u03c0\u03b9\u03b8\u03b1\u03bd\u03cc \u03c0\u03bb\u03b1\u03af\u03c3\u03b9\u03bf \u03b3\u03b9\u03b1 \u03bc\u03b9\u03b1 \u03bc\u03b5\u03bb\u03bb\u03bf\u03bd\u03c4\u03b9\u03ba\u03ae \u03b4\u03b9\u03b5\u03c5\u03b8\u03ad\u03c4\u03b7\u03c3\u03b7 \u03c3\u03c4\u03bf \u039a\u03c5\u03c0\u03c1\u03b9\u03b1\u03ba\u03cc. \u0398\u03b1 \u03b4\u03b5\u03af\u03c4\u03b5 \u03c3\u03cd\u03bd\u03c4\u03bf\u03bc\u03b5\u03c2 \u03b4\u03b7\u03bb\u03ce\u03c3\u03b5\u03b9\u03c2 \u03c5\u03c0\u03ad\u03c1 \u03ba\u03b1\u03b9 \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03c2 \u0394\u0394\u039f \u03ba\u03b1\u03b9 \u03b8\u03b1 \u03b5\u03c0\u03b9\u03bb\u03ad\u03be\u03b5\u03c4\u03b5 \u03c0\u03bf\u03b9\u03b5\u03c2 \u03b2\u03c1\u03af\u03c3\u03ba\u03b5\u03c4\u03b5 \u03c0\u03b9\u03bf \u03c0\u03b5\u03b9\u03c3\u03c4\u03b9\u03ba\u03ad\u03c2. \u0394\u03b5\u03bd \u03c5\u03c0\u03ac\u03c1\u03c7\u03bf\u03c5\u03bd \u03c3\u03c9\u03c3\u03c4\u03ad\u03c2 \u03ae \u03bb\u03ac\u03b8\u03bf\u03c2 \u03b1\u03c0\u03b1\u03bd\u03c4\u03ae\u03c3\u03b5\u03b9\u03c2\u2014\u03b6\u03b7\u03c4\u03bf\u03cd\u03bc\u03b5 \u03c4\u03b7\u03bd \u03b5\u03b9\u03bb\u03b9\u03ba\u03c1\u03b9\u03bd\u03ae \u03c3\u03b1\u03c2 \u03ac\u03c0\u03bf\u03c8\u03b7.\n\u0397 \u0394\u0394\u039f \u03b5\u03af\u03bd\u03b1\u03b9 \u03ad\u03bd\u03b1 \u03bf\u03bc\u03bf\u03c3\u03c0\u03bf\u03bd\u03b4\u03b9\u03b1\u03ba\u03cc \u03c3\u03cd\u03c3\u03c4\u03b7\u03bc\u03b1 \u03bc\u03b5 \u03b4\u03cd\u03bf \u03c3\u03c5\u03bd\u03b9\u03c3\u03c4\u03ce\u03bd\u03c4\u03b5\u03c2 \u03c0\u03bf\u03bb\u03b9\u03c4\u03b5\u03af\u03b5\u03c2 (\u03b3\u03b5\u03c9\u03b3\u03c1\u03b1\u03c6\u03b9\u03ba\u03ad\u03c2 \u03c0\u03b5\u03c1\u03b9\u03bf\u03c7\u03ad\u03c2) \u03ba\u03b1\u03b9 \u03ba\u03bf\u03b9\u03bd\u03ac \u03ba\u03b5\u03bd\u03c4\u03c1\u03b9\u03ba\u03ac \u03b8\u03b5\u03c3\u03bc\u03b9\u03ba\u03ac \u03cc\u03c1\u03b3\u03b1\u03bd\u03b1. \u039f \u03b1\u03ba\u03c1\u03b9\u03b2\u03ae\u03c2 \u03c3\u03c7\u03b5\u03b4\u03b9\u03b1\u03c3\u03bc\u03cc\u03c2 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b4\u03b9\u03b1\u03c6\u03ad\u03c1\u03b5\u03b9. \u0397 \u03ad\u03c1\u03b5\u03c5\u03bd\u03b1 \u03b4\u03b5\u03bd \u03c0\u03c1\u03bf\u03cb\u03c0\u03bf\u03b8\u03ad\u03c4\u03b5\u03b9 \u03c3\u03c5\u03b3\u03ba\u03b5\u03ba\u03c1\u03b9\u03bc\u03ad\u03bd\u03bf \u03c3\u03c7\u03ad\u03b4\u03b9\u03bf \u03b5\u03be\u03b5\u03c4\u03ac\u03b6\u03b5\u03b9 \u03b3\u03b5\u03bd\u03b9\u03ba\u03ad\u03c2 \u03c3\u03c4\u03ac\u03c3\u03b5\u03b9\u03c2 \u03ba\u03b1\u03b9 \u03c0\u03ce\u03c2 \u03b3\u03af\u03bd\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b4\u03b5\u03ba\u03c4\u03ac \u03b4\u03b9\u03b1\u03c6\u03bf\u03c1\u03b5\u03c4\u03b9\u03ba\u03ac \u03b5\u03c0\u03b9\u03c7\u03b5\u03b9\u03c1\u03ae\u03bc\u03b1\u03c4\u03b1.","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_6rN7FrAZHX3rUeq","Element":"SQ","PrimaryAttribute":"QID40","SecondaryAttribute":"\u03a0\u03bf\u03b9\u03b1 \u03b4\u03ae\u03bb\u03c9\u03c3\u03b7 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c0\u03b9\u03bf \u03c0\u03b5\u03b9\u03c3\u03c4\u03b9\u03ba\u03ae;(\u0395\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u03bc\u03cc\u03bd\u03bf \u03bc\u03b9\u03b1 \u0