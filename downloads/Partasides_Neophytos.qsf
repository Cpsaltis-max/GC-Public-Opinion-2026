u03c3\u03c4\u03bf \u03c4\u03ad\u03bb\u03bf\u03c2.\n\u0397 \u03c3\u03c5\u03bc\u03bc\u03b5\u03c4\u03bf\u03c7\u03ae \u03b5\u03af\u03bd\u03b1\u03b9 \u03b5\u03b8\u03b5\u03bb\u03bf\u03bd\u03c4\u03b9\u03ba\u03ae \u03ba\u03b1\u03b9 \u03b1\u03bd\u03ce\u03bd\u03c5\u03bc\u03b7. \u039c\u03c0\u03bf\u03c1\u03b5\u03af\u03c4\u03b5 \u03bd\u03b1 \u03c3\u03c4\u03b1\u03bc\u03b1\u03c4\u03ae\u03c3\u03b5\u03c4\u03b5 \u03bf\u03c0\u03bf\u03b9\u03b1\u03b4\u03ae\u03c0\u03bf\u03c4\u03b5 \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae \u03c7\u03c9\u03c1\u03af\u03c2 \u03c3\u03c5\u03bd\u03ad\u03c0\u03b5\u03b9\u03b5\u03c2. \u0394\u03b5\u03bd \u03c3\u03c5\u03bb\u03bb\u03ad\u03b3\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c0\u03c1\u03bf\u03c3\u03c9\u03c0\u03b9\u03ba\u03ac \u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af\u03b1. \u03a4\u03b1 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03b8\u03b1 \u03b1\u03bd\u03b1\u03bb\u03c5\u03b8\u03bf\u03cd\u03bd \u03c3\u03c5\u03b3\u03ba\u03b5\u03bd\u03c4\u03c1\u03c9\u03c4\u03b9\u03ba\u03ac \u03b3\u03b9\u03b1 \u03b5\u03c1\u03b5\u03c5\u03bd\u03b7\u03c4\u03b9\u03ba\u03bf\u03cd\u03c2 \u03ba\u03b1\u03b9 \u03b5\u03bd\u03b7\u03bc\u03b5\u03c1\u03c9\u03c4\u03b9\u03ba\u03bf\u03cd\u03c2 \u03c3\u03ba\u03bf\u03c0\u03bf\u03cd\u03c2.<br><br>\u039a\u03c1\u03b9\u03c4\u03ae\u03c1\u03b9\u03b1 \u03ba\u03b1\u03b9 \u03a3\u03c5\u03bd\u03b1\u03af\u03bd\u03b5\u03c3\u03b7<br><br>\u0395\u03af\u03bc\u03b1\u03b9 18 \u03b5\u03c4\u03ce\u03bd \u03ae \u03bc\u03b5\u03b3\u03b1\u03bb\u03cd\u03c4\u03b5\u03c1\u03bf\u03c2\/\u03b7.<br>\n\n\u0388\u03c7\u03c9 \u03b4\u03b9\u03ba\u03b1\u03af\u03c9\u03bc\u03b1 \u03a8\u03ae\u03c6\u03bf\u03c5 \u03b1\u03c5\u03c4\u03ae \u03c4\u03b7 \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae<br><br>","QuestionText_Unsafe":"&nbsp;\u03a3\u03c5\u03bc\u03bc\u03b5\u03c4\u03bf\u03c7\u03ae \u03bc\u03b5 \u03a3\u03c5\u03bd\u03b1\u03af\u03bd\u03b5\u03c3\u03b7<br><br>&nbsp;\u03a3\u03b1\u03c2 \u03c0\u03c1\u03bf\u03c3\u03ba\u03b1\u03bb\u03bf\u03cd\u03bc\u03b5 \u03c3\u03b5 \u03bc\u03b9\u03b1 \u03c3\u03cd\u03bd\u03c4\u03bf\u03bc\u03b7 \u03ad\u03c1\u03b5\u03c5\u03bd\u03b1 \u03c3\u03c7\u03b5\u03c4\u03b9\u03ba\u03ac \u03bc\u03b5 \u03b1\u03c0\u03cc\u03c8\u03b5\u03b9\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b9\u03c2 \u03b5\u03c0\u03b5\u03c1\u03c7\u03cc\u03bc\u03b5\u03bd\u03b5\u03c2 \u03b2\u03bf\u03c5\u03bb\u03b5\u03c5\u03c4\u03b9\u03ba\u03ad\u03c2 \u03b5\u03ba\u03bb\u03bf\u03b3\u03ad\u03c2, \u03c4\u03b9\u03c2 \u03c3\u03c4\u03ac\u03c3\u03b5\u03b9\u03c2 \u03c3\u03b1\u03c2 \u03c0\u03c1\u03bf\u03c2 \u03c4\u03bf\u03c5\u03c2 \u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03b9\u03ba\u03bf\u03cd\u03c2 \u03c1\u03cc\u03bb\u03bf\u03c5\u03c2 \u03c4\u03bf\u03c5 \u03c6\u03cd\u03bb\u03bf\u03c5  \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03c0\u03b9\u03b8\u03b1\u03bd\u03ae \u03bb\u03cd\u03c3\u03b7 \u03c4\u03bf\u03c5 \u039a\u03c5\u03c0\u03c1\u03b9\u03b1\u03ba\u03bf\u03cd \u03c0\u03c1\u03bf\u03b2\u03bb\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2. \u0397 \u03ad\u03c1\u03b5\u03c5\u03bd\u03b1 \u03b4\u03b9\u03b1\u03c1\u03ba\u03b5\u03af ~15 \u03bb\u03b5\u03c0\u03c4\u03ac. \u0398\u03b1 \u03b1\u03c0\u03b1\u03bd\u03c4\u03ae\u03c3\u03b5\u03c4\u03b5 \u03c3\u03b5 \u03bc\u03b5\u03c1\u03b9\u03ba\u03ad\u03c2 \u03b5\u03c1\u03c9\u03c4\u03ae\u03c3\u03b5\u03b9\u03c2, \u03b8\u03b1 \u03b4\u03b9\u03b1\u03b2\u03ac\u03c3\u03b5\u03c4\u03b5 \u03c3\u03cd\u03bd\u03c4\u03bf\u03bc\u03b5\u03c2 \u03b4\u03b7\u03bb\u03ce\u03c3\u03b5\u03b9\u03c2 \u03ba\u03b1\u03b9 \u03b8\u03b1 \u03b1\u03c0\u03b1\u03bd\u03c4\u03ae\u03c3\u03b5\u03c4\u03b5 \u03be\u03b1\u03bd\u03ac \u03c3\u03c4\u03bf \u03c4\u03ad\u03bb\u03bf\u03c2.\n\u0397 \u03c3\u03c5\u03bc\u03bc\u03b5\u03c4\u03bf\u03c7\u03ae \u03b5\u03af\u03bd\u03b1\u03b9 \u03b5\u03b8\u03b5\u03bb\u03bf\u03bd\u03c4\u03b9\u03ba\u03ae \u03ba\u03b1\u03b9 \u03b1\u03bd\u03ce\u03bd\u03c5\u03bc\u03b7. \u039c\u03c0\u03bf\u03c1\u03b5\u03af\u03c4\u03b5 \u03bd\u03b1 \u03c3\u03c4\u03b1\u03bc\u03b1\u03c4\u03ae\u03c3\u03b5\u03c4\u03b5 \u03bf\u03c0\u03bf\u03b9\u03b1\u03b4\u03ae\u03c0\u03bf\u03c4\u03b5 \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae \u03c7\u03c9\u03c1\u03af\u03c2 \u03c3\u03c5\u03bd\u03ad\u03c0\u03b5\u03b9\u03b5\u03c2. \u0394\u03b5\u03bd \u03c3\u03c5\u03bb\u03bb\u03ad\u03b3\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c0\u03c1\u03bf\u03c3\u03c9\u03c0\u03b9\u03ba\u03ac \u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af\u03b1. \u03a4\u03b1 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03b8\u03b1 \u03b1\u03bd\u03b1\u03bb\u03c5\u03b8\u03bf\u03cd\u03bd \u03c3\u03c5\u03b3\u03ba\u03b5\u03bd\u03c4\u03c1\u03c9\u03c4\u03b9\u03ba\u03ac \u03b3\u03b9\u03b1 \u03b5\u03c1\u03b5\u03c5\u03bd\u03b7\u03c4\u03b9\u03ba\u03bf\u03cd\u03c2 \u03ba\u03b1\u03b9 \u03b5\u03bd\u03b7\u03bc\u03b5\u03c1\u03c9\u03c4\u03b9\u03ba\u03bf\u03cd\u03c2 \u03c3\u03ba\u03bf\u03c0\u03bf\u03cd\u03c2.<br><br>&nbsp;\u039a\u03c1\u03b9\u03c4\u03ae\u03c1\u03b9\u03b1 \u03ba\u03b1\u03b9 \u03a3\u03c5\u03bd\u03b1\u03af\u03bd\u03b5\u03c3\u03b7<br>\u0395\u03af\u03bc\u03b1\u03b9 18 \u03b5\u03c4\u03ce\u03bd \u03ae \u03bc\u03b5\u03b3\u03b1\u03bb\u03cd\u03c4\u03b5\u03c1\u03bf\u03c2\/\u03b7.<br>\n\n\u0388\u03c7\u03c9 \u03b4\u03b9\u03ba\u03b1\u03af\u03c9\u03bc\u03b1 \u03a8\u03ae\u03c6\u03bf\u03c5 \u03b1\u03c5\u03c4\u03ae \u03c4\u03b7 \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae<br><br>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_6rN7FrAZHX3rUeq","Element":"SQ","PrimaryAttribute":"QID20","SecondaryAttribute":"\u039f\u03b9 \u03ac\u03bd\u03b4\u03c1\u03b5\u03c2 \u03b1\u03c0\u03cc \u03c4\u03b7 \u03c6\u03cd\u03c3\u03b7 \u03c4\u03bf\u03c5\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03ba\u03b1\u03bb\u03cd\u03c4\u03b5\u03c1\u03bf\u03b9 \u03c0\u03bf\u03bb\u03b9\u03c4\u03b9\u03ba\u03bf\u03af \u03b1","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[1,2,3,4,5],"Choices":{"1":{"Display":"\u0394\u03b9\u03b1\u03c6\u03c9\u03bd\u03ce \u03b1\u03c0\u03cc\u03bb\u03c5\u03c4\u03b1"},"2":{"Display":"\u0394\u03b9\u03b1\u03c6\u03c9\u03bd\u03ce"},"3":{"Display":"\u039f\u03cd\u03c4\u03b5 \u03c3\u03c5\u03bc\u03c6\u03c9\u03bd\u03ce, \u03bf\u03cd\u03c4\u03b5 \u03b4\u03