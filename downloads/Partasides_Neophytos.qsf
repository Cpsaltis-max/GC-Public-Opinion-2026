a\u03cd\u03c0\u03c1\u03b9\u03bf\u03c5\u03c2) \u03b3...","QuestionID":"QID80","QuestionText":"\u0397 \u03b1\u03ba\u03cc\u03bb\u03bf\u03c5\u03b8\u03b7 \u03b5\u03c1\u03ce\u03c4\u03b7\u03c3\u03b7 \u03b1\u03c6\u03bf\u03c1\u03ac \u03c4\u03b1 \u03c3\u03c5\u03bd\u03b1\u03b9\u03c3\u03b8\u03ae\u03bc\u03b1\u03c4\u03ac \u03c3\u03b1\u03c2 \u03c0\u03c1\u03bf\u03c2 \u03c4\u03b1 \u03bc\u03ad\u03bb\u03b7 \u03c4\u03b7\u03c2 \u03ac\u03bb\u03bb\u03b7\u03c2 \u03ba\u03bf\u03b9\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 (\u03a4\u03bf\u03c5\u03c1\u03ba\u03bf\u03ba\u03cd\u03c0\u03c1\u03b9\u03bf\u03c5\u03c2) \u03b3\u03b5\u03bd\u03b9\u03ba\u03ac. \u0392\u03b1\u03b8\u03bc\u03bf\u03bb\u03bf\u03b3\u03ae\u03c3\u03c4\u03b5 \u03c4\u03b1 \u03bc\u03b5 \u03ad\u03bd\u03b1 \u03b8\u03b5\u03c1\u03bc\u03cc\u03bc\u03b5\u03c4\u03c1\u03bf \u03c0\u03bf\u03c5 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03b5\u03af \u03b1\u03c0\u03cc \u03bc\u03b7\u03b4\u03ad\u03bd (0) \u03ad\u03c9\u03c2 \u03b5\u03ba\u03b1\u03c4\u03cc (100) \u03bc\u03bf\u03bd\u03ac\u03b4\u03b5\u03c2. \u038c\u03c3\u03bf \u03c5\u03c8\u03b7\u03bb\u03cc\u03c4\u03b5\u03c1\u03bf\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03bf \u03b2\u03b1\u03b8\u03bc\u03cc\u03c2 \u03c4\u03cc\u03c3\u03bf \u03b8\u03b5\u03c1\u03bc\u03cc\u03c4\u03b5\u03c1\u03bf\u03c2 \u03ae \u03b8\u03b5\u03c4\u03b9\u03ba\u03ac \u03bd\u03b9\u03ce\u03b8\u03b5\u03c4\u03b5 \u03b3\u03b9\u03b1 \u03b1\u03c5\u03c4\u03ae\u03bd \u03c4\u03b7\u03bd \u03bf\u03bc\u03ac\u03b4\u03b1. \u038c\u03c3\u03bf \u03c7\u03b1\u03bc\u03b7\u03bb\u03cc\u03c4\u03b5\u03c1\u03bf\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03bf \u03b2\u03b1\u03b8\u03bc\u03cc\u03c2, \u03c4\u03cc\u03c3\u03bf \u03c0\u03b9\u03bf \u03ba\u03c1\u03cd\u03bf \u03ae \u03b1\u03c1\u03bd\u03b7\u03c4\u03b9\u03ba\u03ac \u03bd\u03b9\u03ce\u03b8\u03b5\u03c4\u03b5&nbsp;\u03b3\u03b9\u03b1 \u03b1\u03c5\u03c4\u03ae\u03bd \u03c4\u03b7\u03bd \u03bf\u03bc\u03ac\u03b4\u03b1. \u0391\u03bd \u03b4\u03b5\u03bd \u03bd\u03b9\u03ce\u03b8\u03b5\u03c4\u03b5 \u03bf\u03cd\u03c4\u03b5 \u03b6\u03ad\u03c3\u03c4\u03b7 \u03bf\u03cd\u03c4\u03b5 \u03ba\u03c1\u03cd\u03bf \u03c0\u03c1\u03bf\u03c2 \u03b1\u03c5\u03c4\u03ae\u03bd \u03c4\u03b7\u03bd \u03bf\u03bc\u03ac\u03b4\u03b1 \u03c4\u03bf\u03c0\u03bf\u03b8\u03b5\u03c4\u03ae\u03c3\u03c4\u03b5 \u03c4\u03b7 \u03b2\u03b1\u03b8\u03bc\u03bf\u03bb\u03bf\u03b3\u03af\u03b1 \u03c3\u03b1\u03c2 \u03c3\u03c4\u03bf 50.&nbsp;","QuestionText_Unsafe":"\u0397 \u03b1\u03ba\u03cc\u03bb\u03bf\u03c5\u03b8\u03b7 \u03b5\u03c1\u03ce\u03c4\u03b7\u03c3\u03b7 \u03b1\u03c6\u03bf\u03c1\u03ac \u03c4\u03b1 \u03c3\u03c5\u03bd\u03b1\u03b9\u03c3\u03b8\u03ae\u03bc\u03b1\u03c4\u03ac \u03c3\u03b1\u03c2 \u03c0\u03c1\u03bf\u03c2 \u03c4\u03b1 \u03bc\u03ad\u03bb\u03b7 \u03c4\u03b7\u03c2 \u03ac\u03bb\u03bb\u03b7\u03c2 \u03ba\u03bf\u03b9\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 (\u03a4\u03bf\u03c5\u03c1\u03ba\u03bf\u03ba\u03cd\u03c0\u03c1\u03b9\u03bf\u03c5\u03c2) \u03b3\u03b5\u03bd\u03b9\u03ba\u03ac. \u0392\u03b1\u03b8\u03bc\u03bf\u03bb\u03bf\u03b3\u03ae\u03c3\u03c4\u03b5 \u03c4\u03b1 \u03bc\u03b5 \u03ad\u03bd\u03b1 \u03b8\u03b5\u03c1\u03bc\u03cc\u03bc\u03b5\u03c4\u03c1\u03bf \u03c0\u03bf\u03c5 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03b5\u03af \u03b1\u03c0\u03cc \u03bc\u03b7\u03b4\u03ad\u03bd (0) \u03ad\u03c9\u03c2 \u03b5\u03ba\u03b1\u03c4\u03cc (100) \u03bc\u03bf\u03bd\u03ac\u03b4\u03b5\u03c2. \u038c\u03c3\u03bf \u03c5\u03c8\u03b7\u03bb\u03cc\u03c4\u03b5\u03c1\u03bf\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03bf \u03b2\u03b1\u03b8\u03bc\u03cc\u03c2 \u03c4\u03cc\u03c3\u03bf \u03b8\u03b5\u03c1\u03bc\u03cc\u03c4\u03b5\u03c1\u03bf\u03c2 \u03ae \u03b8\u03b5\u03c4\u03b9\u03ba\u03ac \u03bd\u03b9\u03ce\u03b8\u03b5\u03c4\u03b5 \u03b3\u03b9\u03b1 \u03b1\u03c5\u03c4\u03ae\u03bd \u03c4\u03b7\u03bd \u03bf\u03bc\u03ac\u03b4\u03b1. \u038c\u03c3\u03bf \u03c7\u03b1\u03bc\u03b7\u03bb\u03cc\u03c4\u03b5\u03c1\u03bf\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03bf \u03b2\u03b1\u03b8\u03bc\u03cc\u03c2, \u03c4\u03cc\u03c3\u03bf \u03c0\u03b9\u03bf \u03ba\u03c1\