bb\u03b5\u03b3\u03c7\u03bf\u03c2 \u03c0\u03c1\u03bf\u03c3\u03bf\u03c7\u03ae\u03c2! \u0391\u03c5\u03c4\u03cc\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03ad\u03bb\u03b5\u03b3\u03c7\u03bf\u03c2 \u03c0\u03bf\u03b9\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2\u2014\u03c0\u03b1\u03c1\u03b1\u03ba\u03b1\u03bb\u03ce \u03b5\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u03c0\u03b9\u03bf \u03ba\u03ac\u03c4\u03c9 \u03c4\u03bf \u00ab\u0394\u03b5\u03bd \u03b5\u03af\u03bc\u03b1\u03b9 \u03c3\u03af\u03b3\u03bf\u03c5\u03c1\u03bf...","QuestionID":"QID32","QuestionText":"&nbsp;\u0388\u03bb\u03b5\u03b3\u03c7\u03bf\u03c2 \u03c0\u03c1\u03bf\u03c3\u03bf\u03c7\u03ae\u03c2!&nbsp; \u0391\u03c5\u03c4\u03cc\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03ad\u03bb\u03b5\u03b3\u03c7\u03bf\u03c2 \u03c0\u03bf\u03b9\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2\u2014\u03c0\u03b1\u03c1\u03b1\u03ba\u03b1\u03bb\u03ce \u03b5\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u03c0\u03b9\u03bf \u03ba\u03ac\u03c4\u03c9 \u03c4\u03bf&nbsp; \u00ab\u0394\u03b5\u03bd \u03b5\u03af\u03bc\u03b1\u03b9 \u03c3\u03af\u03b3\u03bf\u03c5\u03c1\u03bf\u03c2\/\u03b7\u00bb \u03ba\u03b1\u03b9 \u03bc\u03b5\u03c4\u03ac \u03c0\u03c1\u03bf\u03c7\u03c9\u03c1\u03ae\u03c3\u03c4\u03b5 \u03c3\u03c4\u03b7\u03bd \u03b5\u03c0\u03cc\u03bc\u03b5\u03bd\u03b7 \u03b5\u03c1\u03ce\u03c4\u03b7\u03c3\u03b7","QuestionText_Unsafe":"&nbsp;\u0388\u03bb\u03b5\u03b3\u03c7\u03bf\u03c2 \u03c0\u03c1\u03bf\u03c3\u03bf\u03c7\u03ae\u03c2!&nbsp; \u0391\u03c5\u03c4\u03cc\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03ad\u03bb\u03b5\u03b3\u03c7\u03bf\u03c2 \u03c0\u03bf\u03b9\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2\u2014\u03c0\u03b1\u03c1\u03b1\u03ba\u03b1\u03bb\u03ce \u03b5\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u03c0\u03b9\u03bf \u03ba\u03ac\u03c4\u03c9 \u03c4\u03bf&nbsp; \u00ab\u0394\u03b5\u03bd \u03b5\u03af\u03bc\u03b1\u03b9 \u03c3\u03af\u03b3\u03bf\u03c5\u03c1\u03bf\u03c2\/\u03b7\u00bb \u03ba\u03b1\u03b9 \u03bc\u03b5\u03c4\u03ac \u03c0\u03c1\u03bf\u03c7\u03c9\u03c1\u03ae\u03c3\u03c4\u03b5 \u03c3\u03c4\u03b7\u03bd \u03b5\u03c0\u03cc\u03bc\u03b5\u03bd\u03b7 \u03b5\u03c1\u03ce\u03c4\u03b7\u03c3\u03b7","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"RecodeValues":{"4":"4","5":"5","6":"1","7":"2","8":"3"}}},{"SurveyID":"SV_6rN7FrAZHX3rUeq","Element":"SQ","PrimaryAttribute":"QID33","SecondaryAttribute":"\u039f\u03b4\u03b7\u03b3\u03af\u03b5\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b7 \u03c3\u03c5\u03bd\u03ad\u03c7\u03b5\u03b9\u03b1 \u0398\u03b1 \u03b4\u03b5\u03af\u03c4\u03b5 \u03c4\u03ce\u03c1\u03b1 20 \u03b6\u03b5\u03cd\u03b3\u03b7 \u03c3\u03cd\u03bd\u03c4\u03bf\u03bc\u03c9\u03bd ","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Matchups","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"\u039f\u03b4\u03b7\u03b3\u03af\u03b5\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b7 \u03c3\u03c5\u03bd\u03ad\u03c7\u03b5\u03b9\u03b1 \u0398\u03b1 \u03b4\u03b5\u03af\u03c4\u03b5 \u03c4\u03ce\u03c1\u03b1 20 \u03b6\u03b5\u03cd\u03b3\u03b7 \u03c3\u03cd\u03bd\u03c4\u03bf\u03bc\u03c9\u03bd \u03b4\u03b7\u03bb\u03ce\u03c3\u03b5\u03c9\u03bd \u03c5\u03c0\u03ad\u03c1 \u03ae \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03c2 \u0394\u03b9\u03b6\u03c9\u03bd\u03b9\u03ba\u03ae\u03c2 \u0394\u03b9\u03ba\u03bf\u03b9\u03bd...","QuestionID":"QID33","QuestionText":"\u039f\u03b4\u03b7\u03b3\u03af\u03b5\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b7 \u03c3\u03c5\u03bd\u03ad\u03c7\u03b5\u03b9\u03b1<br><br>\u0398\u03b1 \u03b4\u03b5\u03af\u03c4\u03b5 \u03c4\u03ce\u03c1\u03b1 20 \u03b6\u03b5\u03cd\u03b3\u03b7 \u03c3\u03cd\u03bd\u03c4\u03bf\u03bc\u03c9\u03bd \u03b4\u03b7\u03bb\u03ce\u03c3\u03b5\u03c9\u03bd \u03c5\u03c0\u03ad\u03c1 \u03ae \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03c2 \u0394\u03b9\u03b6\u03c9\u03bd\u03b9\u03ba\u03ae\u03c2 \u0394\u03b9\u03ba\u03bf\u03b9\u03bd\u03bf\u03c4\u03b9\u03ba\u03ae\u03c2 \u039f\u03bc\u03bf\u03c3\u03c0\u03bf\u03bd\u03b4\u03af\u03b1\u03c2 (\u0394\u0394\u039f). \u0393\u03b9\u03b1 \u03ba\u03ac\u03b8\u03b5 \u03b6\u03b5\u03cd\u03b3\u03bf\u03c2, \u03b5\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u03c4\u03b7 \u03b4\u03ae\u03bb\u03c9\u03c3\u03b7 \u03c0\u03bf\u03c5 \u03c3\u03b1\u03c2 \u03c6\u03b1\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u03c0\u03b9\u03bf \u03c0\u03b5\u03b9\u03c3\u03c4\u03b9\u03ba\u03ae. \u0391\u03bd \u03ba\u03b1\u03bc\u03af\u03b1 (\u03ae \u03ba\u03b1\u03b9 \u03bf\u03b9 \u03b4\u03cd\u03bf) \u03b4\u03b5\u03bd \u03c3\u03b1\u03c2 \u03c0\u03b5\u03af\u03b8\u03b5\u03b9\/\u03c0\u03b5\u03af\u03b8\u03bf\u03c5\u03bd, \u03b5\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u00ab\u039a\u03b1\u03bc\u03af\u03b1 \u03b1\u03c0\u03cc \u03c4\u03b9\u03c2 \u03b4\u03cd\u03bf\u00bb (\u03ae \u00ab\u039a\u03b1\u03b9 \u03bf\u03b9 \u03b4\u03cd\u03bf\u00bb).","QuestionText_Unsafe":"\u039f\u03b4\u03b7\u03b3\u03af\u03b5\u03c2 (Descriptive Text)\n<br><br>\u0398\u03b1 \u03b4\u03b5\u03af\u03c4\u03b5 \u03c4\u03ce\u03c1\u03b1 20 \u03b6\u03b5\u03cd\u03b3\u03b7 \u03c3\u03cd\u03bd\u03c4\u03bf\u03bc\u03c9\u03bd \u03b4\u03b7\u03bb\u03ce\u03c3\u03b5\u03c9\u03bd \u03c5\u03c0\u03ad\u03c1 \u03ae \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03c2 \u0394\u0394\u039f. \u0393\u03b9\u03b1 \u03ba\u03ac\u03b8\u03b5 \u03b6\u03b5\u03cd\u03b3\u03bf\u03c2, \u03b5\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u03c4\u03b7 \u03b4\u03ae\u03bb\u03c9\u03c3\u03b7 \u03c0\u03bf\u03c5 \u03c3\u03b1\u03c2 \u03c6\u03b1\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u03c0\u03b9\u03bf \u03c0\u03b5\u03b9\u03c3\u03c4\u03b9\u03ba\u03ae. \u0391\u03bd \u03ba\u03b1\u03bc\u03af\u03b1 (\u03ae \u03ba\u03b1\u03b9 \u03bf\u03b9 \u03b4\u03cd\u03bf) \u03b4\u03b5\u03bd \u03c3\u03b1\u03c2 \u03c0\u03b5\u03af\u03b8\u03b5\u03b9, \u03b5\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u00ab\u039a\u03b1\u03bc\u03af\u03b1 \u03b1\u03c0\u03cc \u03c4\u03b9\u03c2 \u03b4\u03cd\u03bf\u00bb (\u03ae \u00ab\u039a\u03b1\u03b9 \u03bf\u03b9 \u